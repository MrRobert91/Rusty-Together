{
  "name": "rusty-together",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && node scripts/compress.mjs",
    "typecheck": "tsc -b",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.41",
    "@colyseus/sdk": "^0.18.5",
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@react-three/rapier": "^2.2.0",
    "colyseus": "^0.18.9",
    "express": "^5.3.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three.quarks": "^0.17.1",
    "yuka": "^0.7.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
